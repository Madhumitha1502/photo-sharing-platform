# ====================================================================
# Photo Sharing Platform - Environment Configuration Template
# ====================================================================

# Database Connection (PostgreSQL for production; SQLite file for local zero-config dev)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret (Minimum 32 characters)
JWT_SECRET="photo-sharing-platform-jwt-secret-key-production-32chars"
GALLERY_TOKEN_SECRET="gallery-access-secret-token-key-production-32chars"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloud Object Storage (Cloudinary)
# Free account at https://cloudinary.com
# Required for production cloud photo storage per specification
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
